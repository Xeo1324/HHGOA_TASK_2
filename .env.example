LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_BASE_URL=
# STT_PROVIDER options: local, openai, groq, sarvam, mock
STT_PROVIDER=sarvam
STT_MODEL=saaras:v3
# Sarvam AI (required when STT_PROVIDER=sarvam)
SARVAM_API_KEY=
TTS_PROVIDER=edge
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
DENSE_RETRIEVER=faiss
VECTOR_INDEX_DIR=data/indexes
# Corpus path — use the sample fixture for Render/cloud deployments where the full corpus is not available.
# For local development with the full 12,184-doc corpus, set to: data/novaron_corpus.jsonl
NOVARON_CORPUS_PATH=data/novaron_corpus.jsonl
